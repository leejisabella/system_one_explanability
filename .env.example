# Template for .env (copy to .env and fill in). This file is committed: never put real keys here.
# Loaded automatically by the harness (sysone.env). Variables already set in your
# shell take precedence, and blank values are ignored.

# TypeSafe: Jev (Pilot 0). Use a dedicated key for this project.
TYPESAFE_API_KEY=

# Gemini API (GCP): the Gemini explainer. (Vertex AI is not used.)
GEMINI_API_KEY=

# AWS: Bedrock (case writers, Claude and Llama explainers, simulator, judge), region us-east-2.
# The IAM user needs bedrock:InvokeModel (Converse uses it too); list permissions help with checks.
# Either set an access key pair, or leave these blank and set AWS_PROFILE instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials (SSO, assumed roles).
AWS_SESSION_TOKEN=
AWS_PROFILE=
